# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DASHBOARD_HOST=dashboard.udienza.com
AUDIO_FEED_URL=https://www.udienza.com/feed.xml
VIDEO_FEED_URL=https://www.udienza.com/feed-video.xml
# Optional: YouTube Data API v3 key, restricted to API and server IP.
YOUTUBE_API_KEY=
SYNC_INTERVAL_HOURS=24
# OP3 API bearer token (read-data permission), from https://op3.dev/api/keys
OP3_API_TOKEN=
# Metabase API key (Admin > Settings > Authentication > API keys, group
# Administrators), used by: docker compose run --rm metabase-setup
MB_API_KEY=
